# ---------------------------------------------------------------------------
# CloseLoop environment variables
#
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
#
# Use the project base URL only. Do NOT include /rest/v1, /auth/v1 or a
# trailing path; the Supabase client adds those endpoints itself.
# Correct:   https://your-project.supabase.co
# Incorrect: https://your-project.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute URL used for OAuth redirects and auth emails, including protocol.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated allowlist of emails permitted to sign in and join the
# workspace. Leave empty only while developing.
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Content generation (Phase 2)
#
# OPENAI_API_KEY is optional. Without it the app stays fully usable in
# "local-template-v1" mode: drafts are composed deterministically from the brand
# brain and the UI labels them as template drafts, not model-written AI.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini. Any chat-completions model that supports
# JSON mode works; cost estimates are only shown for known models.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Later phases — leave blank for now
# ---------------------------------------------------------------------------

# Phase 4: 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Phase 4: Meta app (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Phase 4: LinkedIn developer app (OIDC + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
